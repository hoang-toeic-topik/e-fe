# Frontend Configuration Example
# Copy this file to .env and update values as needed

# API Configuration
# Local development
VITE_API_URL=https://94c68067f451.ngrok-free.app

# For ngrok deployment (uncomment to use)
# VITE_API_URL=https://xxxx-xx-xxx-xxx-xx.ngrok.io

# UI Configuration
VITE_DEFAULT_LANGUAGE=en  # Options: en, vi, ko
VITE_DEBUG=true

# Feature Flags
VITE_ENABLE_GRAMMAR_CHECK=true
VITE_ENABLE_PRONUNCIATION=true
VITE_ENABLE_ACCENT_DETECTION=true

# Audio Configuration
VITE_AUDIO_SAMPLE_RATE=16000
VITE_AUDIO_CHANNELS=1

# UI Theme
VITE_THEME=light  # Options: light, dark

